{
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowJs": true,
		"checkJs": false,
		"types": ["node"],
		"ignoreDeprecations": "6.0"
	},
	"include": ["lib/**/*.ts"],
	"exclude": ["lib/**/*.spec.ts", "lib/**/*.test.ts", "vitest.config.ts"]
}
