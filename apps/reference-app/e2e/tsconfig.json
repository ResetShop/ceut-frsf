{
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"module": "esnext",
		"moduleResolution": "bundler",
		"target": "es2022",
		"types": ["node", "@playwright/test"],
		"allowJs": true,
		"outDir": "../dist/out-tsc/e2e",
		"ignoreDeprecations": "6.0",
		"rootDir": ".."
	},
	"include": ["**/*.ts"],
	"exclude": ["node_modules"]
}
