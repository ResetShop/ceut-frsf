meta {
  name: Update Card - Not Found
  type: http
  seq: 10
}

put {
  url: {{baseUrl}}/content/cards/999999
  body: json
  auth: none
}

body:json {
  {
    "title": "Missing"
  }
}

docs {
  # Update Card - Not Found

  Returns 404 for a card that doesn't exist or has been deleted.
}

assert {
  res.status: eq 404
}

tests {
  test("should return 404", function() {
    expect(res.status).to.equal(404);
  });
}
