meta {
  name: Create Card - Invalid Pinning
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/content/cards
  body: json
  auth: none
}

body:json {
  {
    "internalName": "bruno-invalid-pinning",
    "isPinned": true
  }
}

docs {
  # Create Card - Invalid Pinning

  A pinned card must carry a `pinnedPosition` (0-2); omitting it returns 400.
}

assert {
  res.status: eq 400
}

tests {
  test("should return 400 for isPinned without pinnedPosition", function() {
    expect(res.status).to.equal(400);
  });
}
