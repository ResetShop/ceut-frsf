meta {
  name: Create Card
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/content/cards
  body: json
  auth: none
}

body:json {
  {
    "internalName": "{{cardInternalName}}",
    "title": "Becas",
    "content": "Información sobre becas disponibles",
    "link": { "type": "internal", "url": "/recursos/becas" }
  }
}

script:pre-request {
  bru.setVar("cardInternalName", `bruno-card-${Date.now()}`);
}

docs {
  # Create Card

  Creates a new card. A unique `internalName` is generated by the pre-request script so the
  request can be re-run: deleted cards keep their internal name reserved.

  Requires the `content:cards:create` permission.

  ## Contract Types

  - Request: `CreateCardRequest` from `@contracts/card/card.types`
  - Response: `CardData` from `@contracts/card/card.types`

  ## Request Body

  | Field | Type | Required | Default | Description |
  |-------|------|----------|---------|-------------|
  | internalName | string | Yes | - | Unique back-office name (1-100 chars) |
  | legacyId | number | No | - | Unique migration source ID |
  | title | string | No | - | Display title (max 200 chars) |
  | type | string | No | `icon-corner` | `icon-corner`, `header-image` or `full-image` |
  | imageUrl | string | No | - | Absolute `http`/`https` image URL |
  | content | string | No | - | Body content (max 5000 chars) |
  | link | object | No | - | `{ type: 'internal', url: '/path' }` (path starting with a single `/`) or `{ type: 'external', url: 'https://…' }` (`http`/`https` only) |
  | footerContent | string | No | - | Footer text (max 300 chars) |
  | footerSeparator | boolean | No | false | Separator above the footer |
  | enabled | boolean | No | true | Visibility flag |
  | isPinned | boolean | No | false | Pin the card |
  | pinnedPosition | number | When pinned | - | Slot 0-2; must be set when `isPinned` is true and unset otherwise |

  ## Errors

  | Status | Error | Description |
  |--------|-------|-------------|
  | 400 | Validation error | Invalid input, including an inconsistent `isPinned`/`pinnedPosition` pair |
  | 409 | A card with this internal name already exists | Name held by another card, including a deleted one |
  | 409 | A card with this legacy ID already exists | Legacy ID held by another card |
}

assert {
  res.status: eq 201
  res.body.id: isDefined
}

script:post-response {
  if (res.status === 201 && res.body.id) {
    bru.setEnvVar("testCardId", res.body.id);
  }
}

tests {
  test("should return 201 on successful creation", function() {
    expect(res.status).to.equal(201);
  });

  test("should apply contract defaults", function() {
    expect(res.body.type).to.equal("icon-corner");
    expect(res.body.enabled).to.be.true;
    expect(res.body.isPinned).to.be.false;
  });
}
