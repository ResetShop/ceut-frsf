meta {
  name: Update User - Invalid Roles
  type: http
  seq: 14
}

patch {
  url: {{baseUrl}}/users/2
  body: json
  auth: none
}

body:json {
  {
    "firstName": "Should Not Persist",
    "roleIds": [9999],
    "status": "disabled"
  }
}

docs {
  # Update User - Invalid Roles

  Demonstrates the atomic rollback: an unknown role ID fails the role replacement, so the
  profile and status changes in the same request are rolled back as well.
}

assert {
  res.status: eq 400
  res.body.error: isDefined
}

tests {
  test("should return 400 bad request", function() {
    expect(res.status).to.equal(400);
  });

  test("should return roles-not-found error", function() {
    expect(res.body.error).to.include("Roles not found");
  });
}
